# Copy these values into the Render service's Environment page. Do not replace
# your local .env with this file: it is specifically for the live service.

APP_NAME="Agusan National High School Enrollment"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-service-name.onrender.com
ASSET_URL=https://your-service-name.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Render supplies DB_URL automatically from the linked PostgreSQL database in
# render.yaml. Do not add local MySQL credentials or a DB_URL value here.
DB_CONNECTION=pgsql

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_IDLE_TIMEOUT=5
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
RUN_QUEUE_WORKER=true
AUTO_START_LOCAL_IMPORT_WORKER=false
CLASS_LIST_IMPORT_TIMEOUT=240
DB_QUEUE_RETRY_AFTER=300

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# Outbound email is not used by this enrollment-only system.
MAIL_MAILER=log
MAIL_FROM_NAME="Agusan National High School"

# Keep both false for normal deployments. For the first deployment only, set
# RUN_DATABASE_SEEDER=true to create the default staff accounts and reference
# data. Change it back to false and redeploy immediately afterwards.
RUN_DATABASE_FRESH=false
RUN_DATABASE_SEEDER=false

# Do not add APP_KEY here. render.yaml tells Render to generate and retain it.
# If you attach a persistent disk at /var/data, add this in Render too:
# PUBLIC_DISK_ROOT=/var/data
